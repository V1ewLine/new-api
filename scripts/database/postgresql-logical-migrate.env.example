# 复制到仓库外的私密路径后填写，例如：
#   cp scripts/database/postgresql-logical-migrate.env.example /data/secrets/postgresql-logical-migrate.env
#   chmod 600 /data/secrets/postgresql-logical-migrate.env
#
# 这是 shell 配置文件。等号两侧不能有空格，值统一放在单引号中。

# ============================================================
# 必须填写：旧 PostgreSQL 主库
# ============================================================
NEWAPI_SOURCE_MAIN_HOST='127.0.0.1'
NEWAPI_SOURCE_MAIN_DATABASE='new_api'
NEWAPI_SOURCE_MAIN_USER='newapi'
NEWAPI_SOURCE_MAIN_PASSWORD='REDACTED'

# ============================================================
# 必须填写：目标 PostgreSQL
# ============================================================
NEWAPI_TARGET_MAIN_HOST='127.0.0.1'
# 管理账号用于创建数据库，必须已经拥有 CREATEDB 权限。
NEWAPI_TARGET_MAIN_ADMIN_USER='postgres'
NEWAPI_TARGET_MAIN_ADMIN_PASSWORD='REDACTED'
# 应用账号必须已经存在，将成为新数据库和其中对象的所有者。
NEWAPI_TARGET_MAIN_APP_USER='new_api_app'
NEWAPI_TARGET_MAIN_APP_PASSWORD='REDACTED'

# ============================================================
# 必须填写：逻辑备份保存目录
# ============================================================
# 这不是 PostgreSQL 的 PGDATA 原始数据目录，必须使用绝对路径。
NEWAPI_BACKUP_DIR='/data/backups/new-api-migration'

# ============================================================
# 可选：端口、SSL、数据库命名和运行参数
# ============================================================
# 以下均有默认值；只有实际环境不同时才修改。
NEWAPI_SOURCE_MAIN_PORT='5432'
NEWAPI_SOURCE_MAIN_SSLMODE='prefer'
NEWAPI_TARGET_MAIN_PORT='5432'
NEWAPI_TARGET_MAIN_SSLMODE='prefer'
NEWAPI_TARGET_MAIN_ADMIN_DATABASE='postgres'

# 默认自动生成 new_api_prod_YYYYMMDD。
# 可以修改前缀，或者取消最后一行注释并完全手动指定名称。
NEWAPI_TARGET_MAIN_DATABASE_PREFIX='new_api_prod'
# NEWAPI_TARGET_MAIN_DATABASE='new_api_prod_20260727'

NEWAPI_PGCONNECT_TIMEOUT='10'
NEWAPI_VERIFY_ROW_COUNTS='true'

# ============================================================
# 可选：独立日志数据库
# ============================================================
# 如果旧部署没有配置 LOG_SQL_DSN，以下配置全部保持注释。
# 如果使用独立日志库，则取消注释并填写源日志库配置。
# 目标日志库默认复用目标主库的服务器、应用账号和管理连接。
#
# NEWAPI_SOURCE_LOG_HOST='127.0.0.1'
# NEWAPI_SOURCE_LOG_PORT='5432'
# NEWAPI_SOURCE_LOG_DATABASE='new_api_log'
# NEWAPI_SOURCE_LOG_USER='old_newapi_log'
# NEWAPI_SOURCE_LOG_PASSWORD='REDACTED'
# NEWAPI_SOURCE_LOG_SSLMODE='disable'
# NEWAPI_TARGET_LOG_DATABASE_PREFIX='new_api_log_prod'
# NEWAPI_TARGET_LOG_DATABASE='new_api_log_prod_20260727'

# 只有目标日志库使用不同服务器或应用账号时才填写：
# NEWAPI_TARGET_LOG_HOST='127.0.0.1'
# NEWAPI_TARGET_LOG_PORT='5433'
# NEWAPI_TARGET_LOG_APP_USER='new_api_log_app'
# NEWAPI_TARGET_LOG_APP_PASSWORD='REDACTED'
# NEWAPI_TARGET_LOG_SSLMODE='disable'

# ============================================================
# 高级兼容方式
# ============================================================
# 也可以直接提供以下完整连接串。填写后，脚本会优先使用完整连接串，
# 对应的逐项配置可以省略。DSN 模板必须保留 __DATABASE__。
#
# NEWAPI_SOURCE_MAIN_DSN='postgresql://old_newapi:REDACTED@127.0.0.1:5432/new_api?sslmode=disable'
# NEWAPI_TARGET_MAIN_ADMIN_DSN='postgresql://postgres:REDACTED@127.0.0.1:5433/postgres?sslmode=disable'
# NEWAPI_TARGET_MAIN_DSN_TEMPLATE='postgresql://new_api_app:REDACTED@127.0.0.1:5433/__DATABASE__?sslmode=disable'
# NEWAPI_TARGET_MAIN_OWNER='new_api_app'
